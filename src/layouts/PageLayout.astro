---
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
interface Props { title: string; eyebrow?: string; lede?: string; description?: string; image: string; imageAlt?: string; position?: string; crumbs?: { label: string; href?: string }[]; theme?: 'logo' }
const { title, eyebrow, lede, description, image, imageAlt, position, crumbs, theme } = Astro.props;
---
<BaseLayout title={title} description={description} theme={theme}>
  <PageHero {title} {eyebrow} {lede} {image} {imageAlt} {position} {crumbs} />
  <slot />
</BaseLayout>
