---
import PageLayout from '../layouts/PageLayout.astro';
import Reveal from '../components/islands/Reveal';
import ContactForm from '../components/islands/ContactForm';
import Insurance from '../components/sections/Insurance.astro';
import { locations, site } from '../data/site';

const tel = (p: string) => `tel:${p.replace(/-/g, '')}`;
---
<PageLayout
  title="Contact Us"
  eyebrow="We Are Here to Help"
  lede="Questions about care, appointments or billing? Send us a message or call the office closest to you."
  description="Contact Foot & Ankle Specialists of New Jersey. Call or visit our offices in Scotch Plains, Jersey City and Union, NJ, or send us a message."
  image="/images/practice/hero.jpg"
  imageAlt="Bright, modern reception area at a podiatry office in New Jersey"
  position="center 60%"
  crumbs={[{ label: 'Home', href: '/' }, { label: 'Contact' }]}
>
  <section class="aurora py-24 md:py-28">
    <div class="mx-auto grid max-w-7xl gap-14 px-6 lg:grid-cols-12 lg:gap-16">
      <Reveal client:visible className="lg:col-span-7">
        <p class="eyebrow">Send a Message</p>
        <h2 class="mt-4 text-balance font-serif text-4xl leading-[1.1] md:text-5xl">How can we help you?</h2>
        <p class="mt-5 mb-10 text-lg text-taupe-dark">Fill in the form and our team will get back to you. Need an appointment? Use the booking button and pick a time that works.</p>
        <ContactForm client:visible endpoint={site.formEndpoint} phone={site.phone} />
      </Reveal>

      <Reveal client:visible delay={0.12} className="lg:col-span-5">
        <p class="eyebrow">Our Offices</p>
        <h2 class="mt-4 text-balance font-serif text-4xl leading-[1.1] md:text-5xl">Call or visit us</h2>
        <ul class="mt-10 space-y-6">
          {locations.map((l) => (
            <li id={l.id} class="scroll-mt-44 rounded-[1.25rem] border border-ink/10 bg-white p-6 transition duration-500 hover:-translate-y-1 hover:border-taupe hover:shadow-xl hover:shadow-ink/10">
              <h3 class="font-serif text-2xl">{l.name}</h3>
              <p class="mt-2 flex items-start gap-3 text-taupe-dark">
                <svg viewBox="0 0 24 24" class="mt-1 h-5 w-5 shrink-0 text-gold-deep" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                <span>{l.address}</span>
              </p>
              <div class="mt-4 flex flex-wrap gap-3">
                <a href={tel(l.phone)} class="btn btn-dark">Call {l.phone}</a>
                <a href={`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(l.address)}`} target="_blank" rel="noopener" class="btn btn-dark">Directions</a>
              </div>
            </li>
          ))}
        </ul>
        <a href={site.appointment} class="btn-appt mt-10"><span class="btn-fill"></span><span>Book Appointment</span></a>
      </Reveal>
    </div>
  </section>

  <section class="bg-mist py-24 md:py-28">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">Find Us</p>
        <h2 class="mt-4 text-balance font-serif text-4xl leading-[1.1] md:text-5xl">Three offices across New Jersey</h2>
      </div>
      <div class="mt-14 grid gap-8 lg:grid-cols-3">
        {locations.map((l, i) => (
          <Reveal client:visible delay={i * 0.1} className="h-full">
            <div class="group overflow-hidden rounded-[1.5rem] border border-ink/10 bg-white">
              <iframe
                title={`Map of our ${l.name} office`}
                src={`https://www.google.com/maps?q=${encodeURIComponent(l.address)}&output=embed`}
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                class="h-72 w-full grayscale transition duration-700 group-hover:grayscale-0"
              ></iframe>
              <div class="p-6">
                <h3 class="font-serif text-2xl">{l.name}</h3>
                <p class="mt-1 text-sm text-taupe-dark">{l.address}</p>
              </div>
            </div>
          </Reveal>
        ))}
      </div>
    </div>
  </section>
  <Insurance />
</PageLayout>
