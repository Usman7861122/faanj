---
import PageLayout from '../layouts/PageLayout.astro';
import Reveal from '../components/islands/Reveal';
import GetInTouch from '../components/sections/GetInTouch.astro';
import { blogPosts } from '../data/blogPosts';
import { site } from '../data/site';

export function getStaticPaths() {
  return blogPosts.map((post) => ({ params: { post: post.slug }, props: { post } }));
}
const { post } = Astro.props;
const more = blogPosts.filter((p) => p.slug !== post.slug).slice(0, 3);
const fmt = (d: string) => new Date(d + 'T12:00:00').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
const tel = `tel:${site.phone.replace(/-/g, '')}`;
---
<PageLayout
  title={post.title}
  eyebrow={`${fmt(post.date)} · ${post.minutes} min read`}
  description={post.excerpt}
  image="/images/practice/hero.jpg"
  imageAlt="Bright, modern reception area at a podiatry office in New Jersey"
  position="center 60%"
  crumbs={[{ label: 'Home', href: '/' }, { label: 'Blogs', href: '/blogs' }, { label: 'Article' }]}
>
  <article class="aurora py-20 md:py-24">
    <div class="mx-auto max-w-3xl px-6">
      <img src={post.img} alt={post.title} class="aspect-[16/9] w-full rounded-[1.5rem] border border-ink/10 object-cover shadow-2xl shadow-ink/10" />
      <div class="article mt-10" set:html={post.html} />
      <div class="mt-12 rounded-[1.5rem] bg-ink p-8 text-center text-white md:p-10">
        <p class="eyebrow !text-taupe-light">Need help with foot or ankle pain?</p>
        <h2 class="mt-3 text-balance font-serif text-3xl md:text-4xl">Book a visit with our specialists</h2>
        <div class="mt-7 flex flex-wrap items-center justify-center gap-4">
          <a href={site.appointment} class="btn-appt"><span class="btn-fill"></span><span>Book Appointment</span></a>
          <a href={tel} class="btn border border-white/60 text-white hover:bg-white hover:text-ink">Call {site.phone}</a>
        </div>
      </div>
    </div>
  </article>

  <section class="bg-mist py-24">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">Keep Reading</p>
        <h2 class="mt-4 font-serif text-4xl md:text-5xl">More from our blog</h2>
      </div>
      <div class="mt-14 grid gap-10 md:grid-cols-3">
        {more.map((p, i) => (
          <Reveal client:visible delay={i * 0.1} className="h-full">
            <a href={`/${p.slug}`} class="group flex h-full flex-col overflow-hidden rounded-[1.5rem] border border-ink/10 bg-white transition duration-500 hover:-translate-y-2 hover:border-taupe hover:shadow-2xl hover:shadow-ink/15">
              <div class="overflow-hidden">
                <img src={p.img} alt={p.title} loading="lazy" class="aspect-[4/3] w-full object-cover transition duration-700 group-hover:scale-105" />
              </div>
              <div class="flex flex-1 flex-col p-7">
                <p class="eyebrow">{fmt(p.date)}</p>
                <h3 class="mt-3 text-balance font-serif text-2xl leading-snug transition-colors group-hover:text-gold-deep">{p.title}</h3>
              </div>
            </a>
          </Reveal>
        ))}
      </div>
    </div>
  </section>
  <GetInTouch />
</PageLayout>
