---
import PageLayout from '../../layouts/PageLayout.astro';
import Reveal from '../../components/islands/Reveal';
import GetInTouch from '../../components/sections/GetInTouch.astro';
import { site, providers, locations } from '../../data/site';

const tel = `tel:${site.phone.replace(/-/g, '')}`;
const me = providers.find((p) => p.slug === 'patel')!;
const others = providers.filter((p) => p.slug !== 'patel');
const offices = locations.filter((l) => ['scotch-plains', 'union'].includes(l.id));


const ic = {
  cap: '<path d="M22 10 12 5 2 10l10 5 10-5Z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/>',
  award: '<circle cx="12" cy="8" r="6"/><path d="M15.48 12.89 17 22l-5-3-5 3 1.52-9.11"/>',
  steth: '<path d="M11 2v2"/><path d="M5 2v2"/><path d="M5 3H4a2 2 0 0 0-2 2v4a6 6 0 0 0 12 0V5a2 2 0 0 0-2-2h-1"/><path d="M8 15a6 6 0 0 0 12 0v-3"/><circle cx="20" cy="10" r="2"/>',
  flask: '<path d="M10 2v7.31L4.5 19a2 2 0 0 0 1.7 3h11.6a2 2 0 0 0 1.7-3L14 9.31V2"/><path d="M8.5 2h7"/><path d="M7 16h10"/>',
  scissors: '<circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M20 4 8.12 15.88M14.47 14.48 20 20M8.12 8.12 12 12"/>',
  drop: '<path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/>',
  feet: '<path d="M4 16v-2.38C4 11.5 2.97 10.5 3 8c.03-2.72 1.49-6 4.5-6C9.37 2 10 3.8 10 5.5c0 3.11-2 5.66-2 8.68V16a2 2 0 1 1-4 0Z"/><path d="M20 20v-2.38c0-2.12 1.03-3.12 1-5.62-.03-2.72-1.49-6-4.5-6C14.63 6 14 7.8 14 9.5c0 3.11 2 5.66 2 8.68V20a2 2 0 1 0 4 0Z"/><path d="M16 17h4"/><path d="M4 13h4"/>',
  pulse: '<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/><path d="M3.22 12H9.5l.5-1 2 4.5 2-7 1.5 3.5h5.27"/>',
};
const focus = [
  { t: 'Podiatric surgery', i: 'scissors' },
  { t: 'Diabetic foot wounds', i: 'drop' },
  { t: 'Bunions', i: 'feet' },
  { t: 'Hammertoes', i: 'feet' },
  { t: 'Wound care, infections and poor circulation', i: 'pulse' },
];
const path = [
  { i: 'cap', k: 'Undergraduate', t: 'New York University', d: 'Bachelor’s degree.' },
  { i: 'award', k: 'Medical school', t: 'New York College of Podiatric Medicine', d: 'Doctor of Podiatric Surgery and Medicine, graduating at the top of her class. Winner of several awards, including the ABMPS Diabetic Wound Care Award.' },
  { i: 'steth', k: 'Residency', t: 'Morristown Memorial Hospital', d: 'Residency, where she became chief resident and performed over 1,500 foot and ankle surgeries.' },
  { i: 'flask', k: 'Research', t: 'Published research', d: 'Additional research on diabetic foot wounds and on surgical treatment for bunions.' },
];
---
<PageLayout
  title="Dr. Krupa Patel"
  eyebrow={`${me.creds} · ${me.role}`}
  lede="A podiatrist and surgeon who treats bunions, hammertoes and diabetic foot problems at our Scotch Plains and Union offices."
  description="Meet Dr. Krupa Patel, DPM, FACFAS, podiatrist and foot and ankle surgeon at Foot & Ankle Specialists of New Jersey in Scotch Plains and Union, NJ."
  image="/images/providers/surgery-hero.jpg"
  imageAlt="Surgeons working together in a bright operating room"
  position="center 45%"
  crumbs={[{ label: 'Home', href: '/' }, { label: 'Providers', href: '/providers' }, { label: 'Dr. Krupa Patel' }]}
>
  <!-- About -->
  <section class="aurora py-24 md:py-28">
    <div class="mx-auto grid max-w-7xl items-center gap-14 px-6 lg:grid-cols-12 lg:gap-20">
      <Reveal client:visible className="lg:col-span-5">
        <div class="group overflow-hidden rounded-[1.5rem] border border-ink/10 shadow-2xl shadow-ink/10 transition duration-700 hover:-translate-y-2 hover:border-taupe hover:shadow-[0_35px_60px_-20px_rgba(0,0,0,0.35)]">
          <img src={me.img} alt={`${me.name}, ${me.creds}`} width="2250" height="1500" fetchpriority="high" class="aspect-[4/5] w-full object-cover object-[50%_20%] transition duration-700 group-hover:scale-105 group-hover:brightness-105" />
        </div>
      </Reveal>
      <Reveal client:visible delay={0.12} className="lg:col-span-7">
        <p class="eyebrow">About Dr. Patel</p>
        <h2 class="mt-4 font-serif text-4xl leading-[1.08] md:text-5xl xl:text-6xl">Skilled surgery. Caring, steady attention.</h2>
        <div class="mt-8 max-w-2xl space-y-5 text-lg leading-relaxed text-taupe-dark">
          <p>Dr. Krupa Patel is a talented podiatrist who practices at the Scotch Plains and Union, New Jersey offices of Foot &amp; Ankle Specialists of New Jersey.</p>
          <p>She specializes in podiatric surgeries, diabetic foot wounds, and treatments for bunions, hammertoes, and diabetic issues including wound care, infections, and poor circulation.</p>
          <p>Dr. Patel is dedicated to providing excellent care to all of her patients.</p>
        </div>
        <div class="mt-9 flex flex-wrap items-center gap-4">
          <a href={site.appointment} class="btn-appt"><span class="btn-fill"></span><span>Book with Dr. Patel</span></a>
          <a href={tel} class="btn btn-dark">Call {site.phone}</a>
        </div>
      </Reveal>
    </div>
  </section>

  <!-- Focus areas -->
  <section class="bg-mist py-24 md:py-28">
    <div class="mx-auto grid max-w-7xl items-center gap-14 px-6 lg:grid-cols-2 lg:gap-24">
      <Reveal client:visible>
        <img src="/images/providers/wound-care.jpg" alt="Podiatrist wearing gloves dressing a patient’s toes" width="1400" height="1400" loading="lazy" class="img-sq aspect-square w-full object-cover shadow-2xl shadow-ink/10" />
      </Reveal>
      <Reveal client:visible delay={0.12}>
        <p class="eyebrow">Areas of Focus</p>
        <h2 class="mt-4 font-serif text-4xl leading-[1.1] md:text-5xl">What Dr. Patel treats</h2>
        <ul class="mt-10">
          {focus.map((f) => (
            <li class="group flex items-center gap-5 border-b border-ink/10 py-5 first:border-t">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-gold-deep/40 text-gold-deep transition-colors duration-300 group-hover:bg-ink group-hover:text-taupe-light">
                <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ic[f.i]} />
              </span>
              <span class="font-serif text-2xl transition-colors group-hover:text-gold-deep">{f.t}</span>
            </li>
          ))}
        </ul>
        <a href="/services" class="btn btn-dark mt-9">View our services</a>
      </Reveal>
    </div>
  </section>

  <!-- Education and training -->
  <section class="relative overflow-hidden bg-ink py-24 text-white md:py-28">
    <div class="mx-auto max-w-7xl px-6">
      <div class="max-w-2xl">
        <p class="eyebrow !text-taupe-light">Education &amp; Training</p>
        <h2 class="mt-4 font-serif text-4xl leading-[1.1] md:text-5xl">An outstanding student, now an experienced surgeon</h2>
      </div>
      <ol class="relative mt-16">
        <span class="absolute bottom-2 left-[5px] top-2 w-px bg-gradient-to-b from-taupe/70 via-white/20 to-transparent md:left-1/2 md:-translate-x-1/2" aria-hidden="true"></span>
        {path.map((s, i) => (
          <li class:list={['relative pb-10 pl-12 last:pb-0 md:grid md:grid-cols-2 md:pl-0', i > 0 && 'md:-mt-20']}>
            <span class="absolute left-[-13px] top-4 flex h-9 w-9 items-center justify-center rounded-full border border-taupe bg-ink text-taupe-light ring-4 ring-ink md:left-1/2 md:-translate-x-1/2" aria-hidden="true">
              <svg viewBox="0 0 24 24" class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={ic[s.i]} />
            </span>
            <Reveal client:visible delay={0.05} className={i % 2 === 0 ? 'md:col-start-1 md:pr-16' : 'md:col-start-2 md:pl-16'}>
              <div class:list={['group rounded-2xl border border-white/10 bg-white/[0.03] p-7 transition duration-300 hover:-translate-y-1 hover:border-taupe/60 hover:bg-white/[0.06] md:p-8', i % 2 === 0 && 'md:text-right']}>
                <p class="eyebrow !text-taupe-light">{s.k}</p>
                <h3 class="mt-3 font-serif text-2xl md:text-3xl">{s.t}</h3>
                <p class="mt-3 leading-relaxed text-white/70">{s.d}</p>
              </div>
            </Reveal>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Beyond the clinic + offices -->
  <section class="aurora py-24 md:py-28">
    <div class="mx-auto grid max-w-7xl gap-14 px-6 lg:grid-cols-2 lg:gap-24">
      <Reveal client:visible>
        <p class="eyebrow">Beyond the Clinic</p>
        <h2 class="mt-4 font-serif text-4xl leading-[1.1] md:text-5xl">A little about Dr. Patel</h2>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-taupe-dark">When she is not practicing podiatry, Dr. Patel enjoys reading, going to the movies, and spending time with her husband and two sons.</p>
      </Reveal>
      <Reveal client:visible delay={0.12}>
        <p class="eyebrow">Where to Find Her</p>
        <ul class="mt-4">
          {offices.map((o) => (
            <li class="border-b border-ink/10 py-5 first:border-t">
              <h3 class="font-serif text-2xl">{o.name}</h3>
              <p class="mt-1 text-taupe-dark">{o.address}</p>
              <a href={`tel:${o.phone.replace(/-/g, '')}`} class="mt-1 inline-block text-gold-deep transition-colors hover:text-ink">{o.phone}</a>
            </li>
          ))}
        </ul>
      </Reveal>
    </div>
  </section>

  <!-- Other providers -->
  <section class="bg-mist py-24">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">Our Team</p>
        <h2 class="mt-4 font-serif text-4xl md:text-5xl">Meet our other providers</h2>
      </div>
      <div class="mt-14 grid gap-8 sm:grid-cols-3">
        {others.map((p, i) => (
          <Reveal client:visible delay={i * 0.1}>
            <a href={(p as { href?: string }).href ?? `/providers/#${p.slug}`} class="group block text-center">
              <div class="overflow-hidden rounded-[1.5rem] border border-ink/10 transition duration-500 group-hover:-translate-y-2 group-hover:shadow-2xl group-hover:shadow-ink/15">
                <img src={p.img} alt={`${p.name}, ${p.creds}`} loading="lazy" class="aspect-square w-full object-cover object-top transition duration-700 group-hover:scale-105" />
              </div>
              <h3 class="mt-5 font-serif text-2xl transition-colors group-hover:text-gold-deep">{p.name}</h3>
              <p class="text-sm text-taupe-dark">{p.creds}</p>
            </a>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <GetInTouch />
</PageLayout>
