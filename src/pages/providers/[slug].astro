---
import PageLayout from '../../layouts/PageLayout.astro';
import ProviderProfile from '../../components/sections/ProviderProfile.astro';
import { profiles } from '../../data/providerProfiles';
import { providers } from '../../data/site';

export function getStaticPaths() {
  return profiles.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const me = providers.find((x) => x.slug === p.slug)!;
---
<PageLayout
  title={p.title}
  eyebrow={`${me.creds} · ${me.role}`}
  lede={p.lede}
  description={p.description}
  image={p.hero}
  imageAlt={p.heroAlt}
  position={p.heroPos}
  crumbs={[{ label: 'Home', href: '/' }, { label: 'Providers', href: '/providers' }, { label: p.title }]}
>
  <ProviderProfile p={p} />
</PageLayout>
