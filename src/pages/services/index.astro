---
import PageLayout from '../../layouts/PageLayout.astro';
import Reveal from '../../components/islands/Reveal';
import LocationCards from '../../components/sections/LocationCards.astro';
import Insurance from '../../components/sections/Insurance.astro';
import { services, site } from '../../data/site';

const tel = `tel:${site.phone.replace(/-/g, '')}`;
---
<PageLayout
  title="Our Services"
  eyebrow="What We Treat"
  lede="From heel pain to ankle injuries, our foot and ankle specialists find the cause and build a plan that gets you moving again."
  description="Foot and ankle services in Scotch Plains, Jersey City and Union, NJ: Achilles tendonitis, gout, hammer toe, ankle injuries, heel pain, heel spur, ingrown toenail and athlete’s foot."
  image="/images/practice/hero.jpg"
  imageAlt="Bright, modern reception area at a podiatry office in New Jersey"
  position="center 60%"
  crumbs={[{ label: 'Home', href: '/' }, { label: 'Services' }]}
>
  <section class="aurora py-24 md:py-28">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">Services We Offer</p>
        <h2 class="mt-4 text-balance font-serif text-4xl leading-[1.1] md:text-5xl">Complete foot &amp; ankle care under one roof</h2>
        <p class="mt-5 text-lg text-taupe-dark">Pick a condition to learn about the signs, the causes and how we treat it. Not sure what you have? Call us and we will help.</p>
      </div>
      <div class="mt-16 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((s, i) => (
          <Reveal client:visible delay={(i % 3) * 0.1} className="h-full">
            <a href={`/services/${s.slug}`} class="group flex h-full flex-col overflow-hidden rounded-[1.5rem] border border-ink/10 bg-white transition duration-500 hover:-translate-y-2 hover:border-taupe hover:shadow-2xl hover:shadow-ink/15">
              <div class="overflow-hidden">
                <img src={s.img} alt={s.title} loading={i < 3 ? 'eager' : 'lazy'} class="aspect-[4/3] w-full object-cover transition duration-700 group-hover:scale-105" />
              </div>
              <div class="flex flex-1 flex-col p-7">
                <h3 class="font-serif text-3xl leading-tight transition-colors group-hover:text-gold-deep">{s.title}</h3>
                <p class="mt-3 leading-relaxed text-taupe-dark">{s.text}</p>
                <span class="mt-auto pt-6"><span class="btn btn-dark group-hover:-translate-y-0.5 group-hover:bg-ink group-hover:text-white group-hover:shadow-lg">Learn more</span></span>
              </div>
            </a>
          </Reveal>
        ))}
      </div>
      <div class="mt-14 flex flex-wrap items-center justify-center gap-4">
        <a href={site.appointment} class="btn-appt"><span class="btn-fill"></span><span>Book Appointment</span></a>
        <a href={tel} class="btn btn-dark">Call {site.phone}</a>
        <a href="/conditions" class="btn btn-dark">All conditions we treat</a>
      </div>
    </div>
  </section>
  <LocationCards title="Find a foot &amp; ankle office near you" />
  <Insurance />
</PageLayout>
