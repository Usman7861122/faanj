---
import PageLayout from '../../../layouts/PageLayout.astro';
import ServiceDetail from '../../../components/sections/ServiceDetail.astro';
import { serviceContent } from '../../../data/serviceContent';
import { achillesLocalPages } from '../../../data/achillesLocal';
import { serviceLocalPages } from '../../../data/serviceLocal';

export function getStaticPaths() {
  const all = [
    ...achillesLocalPages.map((l) => ({ ...l, slug: 'achilles-tendonitis' })),
    ...serviceLocalPages,
  ];
  return all.map((l) => {
    const base = serviceContent.find((c) => c.slug === l.slug)!;
    return { params: { slug: l.slug, location: l.id }, props: { base, l } };
  });
}
const { base, l } = Astro.props;
const dir = base.slug === 'achilles-tendonitis' ? 'achilles' : base.slug;
const c = {
  ...base,
  title: `${l.title} ${l.accent}`,
  hero: `/images/services/${dir}/local/hero.jpg`,
  heroAlt: l.heroAlt,
  heroPos: base.slug === 'achilles-tendonitis' ? '60% 55%' : (base.heroPos ?? '50% 50%'),
  whatTitle: l.whatTitle,
  what: l.what,
  whatImg: `/images/services/${dir}/local/consult.jpg`,
  whatImgAlt: l.whatImgAlt,
  symptomsTitle: l.symptomsTitle,
  causesTitle: l.causesTitle,
  treatTitle: l.treatTitle,
  treatText: l.treatText,
  treatments: l.treatments,
  treatImg: `/images/services/${dir}/local/band.jpg`,
  treatImgAlt: l.treatImgAlt,
  tipsTitle: l.tipsTitle,
  tips: l.tips,
};
---
<PageLayout
  title={l.title}
  titleAccent={l.accent}
  metaTitle={`${l.title} ${l.accent}, NJ`}
  eyebrow={`${l.city} Office`}
  lede={l.lede}
  description={l.description}
  image={c.hero}
  imageAlt={c.heroAlt}
  position={c.heroPos}
  areas={l.areas}
  crumbs={[{ label: 'Home', href: '/' }, { label: 'Services', href: '/services' }, { label: base.title, href: `/services/${base.slug}` }, { label: l.city }]}
>
  <ServiceDetail c={c} local={l} />
</PageLayout>
