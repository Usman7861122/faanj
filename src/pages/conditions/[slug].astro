---
import ConditionPage from '../../components/sections/ConditionPage.astro';
import { conditions } from '../../data/conditions';
export function getStaticPaths() {
  return conditions.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props;
---
<ConditionPage c={c} />
