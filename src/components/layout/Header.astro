---
import { nav, site, providers, locations } from '../../data/site';
import { conditions, conditionRegions } from '../../data/conditions';
import MobileMenu from '../islands/MobileMenu';
interface Props { overlay?: boolean }
const { overlay = false } = Astro.props;
const tel = `tel:${site.phone.replace(/-/g, '')}`;
const panel = 'invisible absolute top-full z-10 translate-y-3 pt-3 opacity-0 transition duration-300 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100';
const link = 'whitespace-nowrap text-[12px] uppercase tracking-[0.16em] font-medium text-white transition-colors hover:text-taupe';
---
<header id="site-header" data-overlay={overlay ? 'true' : 'false'}
  class:list={['inset-x-0 top-0 z-50 text-white transition-[background-color,box-shadow,backdrop-filter] duration-500', overlay ? 'fixed bg-transparent' : 'sticky bg-ink shadow-lg shadow-black/10']}>
  <!-- Tier 1: brand + actions -->
  <div class="border-b border-white/15">
    <div class="mx-auto flex h-24 max-w-7xl items-center justify-between gap-6 px-6">
      <a href="/" aria-label={`${site.name} home`} class="shrink-0">
        <img src="/images/logo-transparent.png" alt={site.name} width="1000" height="234" class="logo-img h-[3.75rem] w-auto sm:h-[4.25rem]" />
      </a>
      <div class="hidden items-center gap-6 lg:flex">
        <a href={tel} class="btn btn-light gap-3" aria-label={`Call ${site.phone}`}>
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
          <span>{site.phone}</span>
        </a>
        <a href={site.appointment} class="btn-appt"><span class="btn-fill"></span><span>Book Appointment</span></a>
      </div>
      <div class="lg:hidden"><MobileMenu client:media="(max-width: 1023px)" items={nav} phone={site.phone} appointment={site.appointment} /></div>
    </div>
  </div>

  <!-- Tier 2: navigation -->
  <nav class="hidden lg:block" aria-label="Main">
    <ul class="relative mx-auto flex h-12 max-w-7xl items-center justify-center gap-10 px-6">
      {nav.map((n) => {
        const condMega = n.label === 'Conditions';
        const mega = n.label === 'Services' || condMega;
        return (
        <li class:list={['group flex h-full items-center', !mega && 'relative']}>
          <a href={n.href} class={`${link} flex items-center gap-1.5`} target={n.external ? '_blank' : undefined} rel={n.external ? 'noopener' : undefined}>
            {n.label}
            {n.children && <svg class="h-2.5 w-2.5 opacity-70 transition-transform duration-300 group-hover:rotate-180" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 1l4 4 4-4" /></svg>}
          </a>

          {n.children && (
            <div class:list={[panel, condMega ? 'left-1/2 w-[min(68rem,calc(100vw-3rem))] -translate-x-1/2' : mega ? 'left-1/2 w-[min(56rem,calc(100vw-3rem))] -translate-x-1/2' : n.label === 'Our Practice' ? 'left-1/2 w-[min(44rem,calc(100vw-3rem))] -translate-x-1/2' : n.label === 'Providers' ? 'left-1/2 w-[min(46rem,calc(100vw-3rem))] -translate-x-1/2' : 'left-1/2 w-[26rem] -translate-x-1/2']}>
              <div class="rounded-2xl border border-white/10 bg-ink-deep/95 p-5 shadow-2xl shadow-black/40 backdrop-blur-xl">
                {condMega && (
                  <div class="p-1">
                    <div class="flex items-end justify-between gap-6 border-b border-white/10 pb-4">
                      <div>
                        <p class="text-[10px] uppercase tracking-[0.28em] text-taupe">Conditions We Treat</p>
                        <p class="mt-2 font-serif text-3xl leading-tight text-white">Find your condition</p>
                      </div>
                      <a href="/conditions" class="btn btn-light !min-h-11 !px-5 !text-[11px]">View all conditions</a>
                    </div>
                    <div class="mt-5 grid grid-cols-3 gap-x-8 gap-y-6">
                      {conditionRegions.map((r) => {
                        const list = conditions.filter((c) => c.region === r);
                        return (
                          <div>
                            <p class="font-serif text-xl text-taupe">{r}</p>
                            <ul class="mt-2">
                              {list.slice(0, 5).map((c) => (
                                <li><a href={`/conditions/${c.slug}`} class="block truncate border-b border-white/10 py-2 text-[14px] text-white/80 transition-colors hover:text-white" title={c.title}>{c.title}</a></li>
                              ))}
                            </ul>
                            <a href="/conditions" class="mt-2 inline-block text-[11px] uppercase tracking-[0.18em] text-taupe-light hover:text-white">+ {Math.max(list.length - 5, 0)} more →</a>
                          </div>
                        );
                      })}
                    </div>
                  </div>
                )}
                {n.label === 'Services' && (
                  <div class="grid grid-cols-[15rem_1fr] gap-8 p-1">
                    <div class="flex flex-col justify-between border-r border-white/10 pr-8">
                      <div>
                        <p class="text-[10px] uppercase tracking-[0.28em] text-taupe">Services We Offer</p>
                        <p class="mt-3 font-serif text-3xl leading-tight text-white">Conditions we treat</p>
                        <p class="mt-3 text-sm leading-relaxed text-white/65">Expert care for the foot and ankle, from everyday pain to complex surgery.</p>
                      </div>
                      <div class="mt-6 flex flex-wrap gap-3">
                        <a href="/services" class="btn btn-light !min-h-11 !px-5 !text-[11px]">View all services</a>
                        <a href="/conditions" class="btn btn-light !min-h-11 !px-5 !text-[11px]">Conditions we treat</a>
                      </div>
                    </div>
                    <ul class="grid grid-cols-2 gap-x-8">
                      {n.children.filter((c) => c.label !== 'View More Services' && c.label !== 'Conditions We Treat').map((c, k) => (
                        <li>
                          <a href={c.href} class="group/row flex items-center gap-4 border-b border-white/10 py-3.5 text-white/85 transition-colors hover:text-white">
                            <span class="w-6 font-serif text-sm text-taupe/80 transition-colors group-hover/row:text-taupe">{String(k + 1).padStart(2, '0')}</span>
                            <span class="flex-1 font-serif text-xl">{c.label}</span>
                            <span class="-translate-x-2 text-taupe-light opacity-0 transition duration-300 group-hover/row:translate-x-0 group-hover/row:opacity-100">→</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                {n.label === 'Our Practice' && (
                  <div class="grid grid-cols-[14rem_1fr] gap-8 p-1">
                    <div class="flex flex-col justify-between border-r border-white/10 pr-8">
                      <div>
                        <p class="text-[10px] uppercase tracking-[0.28em] text-taupe">About</p>
                        <p class="mt-3 font-serif text-3xl leading-tight text-white">Our Practice</p>
                        <p class="mt-3 text-sm leading-relaxed text-white/65">Meet our team and see our three New Jersey offices.</p>
                      </div>
                      <a href="/our-practice" class="btn btn-light mt-6 !min-h-11 !px-5 !text-[11px]">Meet the team</a>
                    </div>
                    <div>
                      <p class="px-1 text-[10px] uppercase tracking-[0.28em] text-taupe">Patient Forms</p>
                      <ul class="mt-2">
                        {n.children.flatMap((c) => c.children ?? [c]).map((g, k) => (
                          <li>
                            <a href={g.href} target="_blank" rel="noopener" class="group/row flex items-center gap-4 border-b border-white/10 py-3.5 text-white/85 transition-colors hover:text-white">
                              <span class="w-6 font-serif text-sm text-taupe/80 transition-colors group-hover/row:text-taupe">{String(k + 1).padStart(2, '0')}</span>
                              <span class="flex-1 font-serif text-xl">{g.label}</span>
                              <span class="-translate-x-2 text-taupe-light opacity-0 transition duration-300 group-hover/row:translate-x-0 group-hover/row:opacity-100">↗</span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                )}

                {n.label === 'Providers' && (
                  <div class="grid grid-cols-[14rem_1fr] gap-8 p-1">
                    <div class="flex flex-col justify-between border-r border-white/10 pr-8">
                      <div>
                        <p class="text-[10px] uppercase tracking-[0.28em] text-taupe">Our Team</p>
                        <p class="mt-3 font-serif text-3xl leading-tight text-white">Our Providers</p>
                        <p class="mt-3 text-sm leading-relaxed text-white/65">Board-certified podiatrists and foot and ankle surgeons.</p>
                      </div>
                      <a href="/providers" class="btn btn-light mt-6 !min-h-11 !px-5 !text-[11px]">View all providers</a>
                    </div>
                    <ul>
                      {n.children.map((c, k) => (
                        <li>
                          <a href={c.href} class="group/row flex items-center gap-4 border-b border-white/10 py-3.5 text-white/85 transition-colors hover:text-white">
                            <span class="w-6 font-serif text-sm text-taupe/80 transition-colors group-hover/row:text-taupe">{String(k + 1).padStart(2, '0')}</span>
                            <span class="flex-1">
                              <span class="block font-serif text-xl">{c.label}</span>
                              <span class="block text-[11px] uppercase tracking-[0.18em] text-white/50">{providers.find((p) => c.href?.endsWith(`#${p.slug}`))?.creds}</span>
                            </span>
                            <span class="-translate-x-2 text-taupe-light opacity-0 transition duration-300 group-hover/row:translate-x-0 group-hover/row:opacity-100">→</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                {n.label === 'Locations' && (
                  <ul>
                    {n.children.map((c, k) => {
                      const loc = locations.find((l) => c.href?.endsWith(`#${l.id}`));
                      return (
                        <li>
                          <a href={c.href} class="group/row flex items-center gap-4 border-b border-white/10 py-3.5 text-white/90 transition-colors last:border-0 hover:text-white">
                            <span class="w-6 font-serif text-sm text-taupe/80 transition-colors group-hover/row:text-taupe">{String(k + 1).padStart(2, '0')}</span>
                            <span class="flex-1">
                              <span class="block font-serif text-xl">{c.label}</span>
                              <span class="block text-[11px] tracking-[0.04em] text-white/60">{loc?.address}</span>
                            </span>
                            <span class="-translate-x-2 text-taupe opacity-0 transition duration-300 group-hover/row:translate-x-0 group-hover/row:opacity-100">→</span>
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                )}

                {n.label === 'Testimonials' && n.children.map((c) => (
                  <a href={c.href} class="group/card block rounded-xl border border-white/10 p-5 transition-colors hover:border-taupe hover:bg-white/5">
                    <span class="flex gap-1 text-taupe">{[0,1,2,3,4].map(() => <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.6 5.5 6 .8-4.4 4.2 1.1 6L10 15l-5.3 3 1.1-6L1.4 7.8l6-.8L10 1.5z"/></svg>)}</span>
                    <span class="mt-3 block font-serif text-2xl text-white">{c.label}</span>
                    <span class="mt-1 block text-xs text-white/70">See what our patients say about us →</span>
                  </a>
                ))}
              </div>
            </div>
          )}
        </li>
        );
      })}
    </ul>
  </nav>
</header>

<script is:inline>
  (function () {
    var h = document.getElementById('site-header');
    if (!h || h.dataset.overlay !== 'true') return;
    var on = function () { h.classList.toggle('header-solid', window.scrollY > 40); };
    on();
    window.addEventListener('scroll', on, { passive: true });
    document.addEventListener('astro:page-load', on);
  })();
</script>
