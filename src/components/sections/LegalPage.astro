---
import PageLayout from '../../layouts/PageLayout.astro';
import { site } from '../../data/site';
import type { LegalDoc } from '../../data/legal';

interface Props { doc: LegalDoc }
const { doc } = Astro.props;
const tel = `tel:${site.phone.replace(/-/g, '')}`;
const id = (h: string) => h.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
---
<PageLayout
  title={doc.title}
  eyebrow={doc.eyebrow}
  lede={doc.lede}
  description={doc.description}
  image="/images/practice/hero.jpg"
  imageAlt="Bright, modern reception area at a podiatry office in New Jersey"
  position="center 60%"
  crumbs={[{ label: 'Home', href: '/' }, { label: doc.title }]}
>
  <section class="aurora py-20 md:py-24">
    <div class="mx-auto grid max-w-6xl gap-12 px-6 lg:grid-cols-12 lg:gap-16">
      <aside class="lg:col-span-4">
        <nav aria-label="On this page" class="rounded-[1.25rem] border border-ink/10 bg-white p-6 lg:sticky lg:top-40">
          <p class="eyebrow">On this page</p>
          <ol class="mt-4 space-y-2.5 text-[15px] text-taupe-dark">
            {doc.sections.map((s, i) => (
              <li><a href={`#${id(s.h)}`} class="transition hover:text-ink"><span class="mr-2 text-gold-deep">{String(i + 1).padStart(2, '0')}</span>{s.h}</a></li>
            ))}
          </ol>
        </nav>
      </aside>
      <div class="lg:col-span-8">
        <p class="text-sm uppercase tracking-[0.18em] text-taupe-dark">Last updated {doc.updated}</p>
        {doc.sections.map((s) => (
          <section id={id(s.h)} class="scroll-mt-40">
            <h2 class="mt-12 font-serif text-3xl leading-tight">{s.h}</h2>
            {s.p?.map((t) => <p class="mt-4 text-lg leading-[1.8] text-taupe-dark">{t}</p>)}
            {s.ul && (
              <ul class="mt-4 list-disc space-y-2 pl-6 text-lg leading-[1.7] text-taupe-dark">
                {s.ul.map((t) => <li>{t}</li>)}
              </ul>
            )}
          </section>
        ))}
        <div class="mt-14 flex flex-wrap gap-4">
          <a href={tel} class="btn btn-dark">Call {site.phone}</a>
          <a href="/contact" class="btn btn-dark">Contact us</a>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
