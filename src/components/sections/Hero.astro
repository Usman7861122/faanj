---
import HeroText from '../islands/HeroText';
import { site } from '../../data/site';
---
<section class="relative flex min-h-svh items-center overflow-hidden bg-ink" aria-label="Welcome">
  <video class="absolute inset-0 h-full w-full object-cover" autoplay muted loop playsinline preload="metadata" poster="/images/site/video-poster.jpg" aria-hidden="true">
    <source src="/video/Footankle-1+Desktop.mp4" type="video/mp4" />
  </video>
  <div class="hero-veil absolute inset-0 bg-gradient-to-r from-ink/90 via-ink/60 to-ink/20"></div>
  <div class="hero-veil absolute inset-x-0 top-0 h-56 bg-gradient-to-b from-ink-deep/80 to-transparent"></div>
  <div class="hero-veil absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-ink/70 to-transparent"></div>
  <div class="relative mx-auto w-full max-w-7xl px-6 pb-20 pt-44">
    <HeroText client:load appointment={site.appointment} phone={site.phone} />
  </div>
</section>
