---
interface Props { title: string; eyebrow?: string; lede?: string; image: string; imageAlt?: string; position?: string; crumbs?: { label: string; href?: string }[]; areas?: string; titleAccent?: string }
const { title, eyebrow, lede, image, imageAlt = '', position = 'center', crumbs = [], areas, titleAccent } = Astro.props;
---
<section class="relative isolate overflow-hidden bg-ink-deep text-white">
  <img src={image} alt={imageAlt} width="2400" height="1200" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover" style={`object-position:${position}`} />
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-ink-deep/90 via-ink/70 to-ink/40"></div>
  <div class="absolute inset-x-0 bottom-0 -z-10 h-32 bg-gradient-to-t from-ink-deep/70 to-transparent"></div>
  <div class="mx-auto max-w-7xl px-6 pb-24 pt-20 md:pb-32 md:pt-28">
    {crumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="mb-8 text-xs uppercase tracking-[0.2em] text-white/70">
        <ol class="flex flex-wrap items-center gap-2">
          {crumbs.map((c, i) => (
            <li class="flex items-center gap-2">
              {c.href ? <a href={c.href} class="transition-colors hover:text-white">{c.label}</a> : <span class="text-taupe-light">{c.label}</span>}
              {i < crumbs.length - 1 && <span aria-hidden="true">/</span>}
            </li>
          ))}
        </ol>
      </nav>
    )}
    {eyebrow && <p class="eyebrow !text-taupe-light">{eyebrow}</p>}
    <h1 class="mt-4 max-w-3xl font-serif text-5xl leading-[1.05] md:text-7xl">{title}{titleAccent && <> <span class="text-taupe-light">{titleAccent}</span></>}</h1>
    {lede && <p class="mt-6 max-w-xl text-lg text-white/80 md:text-xl">{lede}</p>}
    {areas && (
      <div class="mt-12 border-t border-white/20 pt-8 md:mt-16">
        <p class="flex max-w-4xl items-start gap-4 text-base leading-relaxed text-white/80 md:text-lg">
          <svg viewBox="0 0 24 24" class="mt-1 h-6 w-6 shrink-0 text-taupe-light" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          <span>{areas}</span>
        </p>
      </div>
    )}
  </div>
</section>
