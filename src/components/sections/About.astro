---
import Reveal from '../islands/Reveal';
---
<section class="aurora py-28">
  <div class="mx-auto grid max-w-7xl items-center gap-16 lg:gap-24 px-6 md:grid-cols-2">
    <Reveal client:visible>
      <p class="eyebrow">About Us</p>
      <h2 class="mt-4 font-serif text-5xl leading-[1.08] md:text-6xl xl:text-7xl">Thoughtful care for every step you take</h2>
      <p class="mt-8 max-w-xl text-lg leading-relaxed text-taupe-dark md:text-xl">
        Foot &amp; Ankle Specialists of New Jersey brings together board-certified podiatrists and surgeons who listen first, then treat.
        With three convenient offices, we pair modern techniques with a calm, personal approach.
      </p>
      <a href="/our-practice" class="btn btn-dark btn-yellow mt-8">Our Practice</a>
    </Reveal>
    <Reveal client:visible delay={0.15}>
      <img src="/images/team/group.webp" alt="The Foot & Ankle Specialists of New Jersey physician team" width="1600" height="1056" loading="lazy" class="img-sq object-[56%_50%] shadow-2xl shadow-ink/10" />
    </Reveal>
  </div>
</section>
