---
import { insurance } from '../../data/site';
const row = [...insurance, ...insurance];
---
<section class="aurora py-24">
  <div class="mx-auto max-w-7xl px-6 text-center">
    <p class="eyebrow">Insurances We Accept</p>
    <h2 class="mt-4 font-serif text-4xl">Care that fits your coverage</h2>
  </div>
  <div class="mt-12 overflow-hidden [mask-image:linear-gradient(90deg,transparent,#000_10%,#000_90%,transparent)]">
    <div class="flex w-max items-center gap-6 [animation:marquee_40s_linear_infinite] hover:[animation-play-state:paused]">
      {row.map((src) => (
        <div class="card-hover flex h-24 w-48 shrink-0 items-center justify-center rounded-2xl border border-ink/10 bg-white p-4">
          <img src={src} alt="Accepted insurance logo" loading="lazy" class="max-h-full max-w-full object-contain" />
        </div>
      ))}
    </div>
  </div>
  <div class="mt-10 text-center"><a href="/our-practice" class="btn btn-dark">View Full List</a></div>
</section>
